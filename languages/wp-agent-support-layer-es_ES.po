#. Plugin Name of the plugin
#: wp-agent-support-layer.php
msgid "WP Agent Support Layer"
msgstr "WP Agent Support Layer"

#. Plugin URI of the plugin
#: wp-agent-support-layer.php
msgid "https://github.com/111x-SAS/wp-agent-support-layer"
msgstr "https://github.com/111x-SAS/wp-agent-support-layer"

#. Description of the plugin
#: wp-agent-support-layer.php
msgid "Makes your site discoverable, readable and operable by AI agents and crawlers: Markdown delivery, Content Signals, AI crawler rules in robots.txt, llms.txt and agent manifests."
msgstr "Hace que tu sitio sea descubrible, legible y operable por agentes y crawlers de IA: entrega en Markdown, Content Signals, reglas para crawlers de IA en robots.txt, llms.txt y manifiestos de agente."

#. Author of the plugin
#: wp-agent-support-layer.php
msgid "Mao Rodriguez"
msgstr "Mao Rodriguez"

#. Author URI of the plugin
#: wp-agent-support-layer.php
msgid "https://111x.co"
msgstr "https://111x.co"

#: src/Admin/ExcludeMetaBox.php:69
msgid "Exclude from the agent layer (Markdown, llms.txt, manifests)."
msgstr "Excluir de la capa de agentes (Markdown, llms.txt, manifiestos)."

#: src/Admin/ExcludeMetaBox.php:104
#: src/Admin/Page.php:92
#: src/Admin/Page.php:93
#: src/Admin/Page.php:175
msgid "Agent Support Layer"
msgstr "Agent Support Layer"

#: src/Admin/ExcludeMetaBox.php:123
msgid "Exclude from the agent layer"
msgstr "Excluir de la capa de agentes"

#: src/Admin/ExcludeMetaBox.php:125
msgid "Hides this item from the Markdown version, llms.txt and the agent manifest."
msgstr "Oculta este elemento de la versión Markdown, de llms.txt y del manifiesto de agente."

#: src/Admin/Page.php:126
msgid "Settings"
msgstr "Ajustes"

#: src/Admin/Page.php:167
msgid "You do not have permission to access this page."
msgstr "No tienes permiso para acceder a esta página."

#: src/Admin/Page.php:177
msgid "Secondary menu"
msgstr "Menú secundario"

#: src/Admin/Tabs/GeneralTab.php:45
msgid "General"
msgstr "General"

#: src/Admin/Tabs/GeneralTab.php:64
msgid "Hourly"
msgstr "Cada hora"

#: src/Admin/Tabs/GeneralTab.php:65
msgid "Twice daily"
msgstr "Dos veces al día"

#: src/Admin/Tabs/GeneralTab.php:66
msgid "Daily"
msgstr "Diario"

#: src/Admin/Tabs/GeneralTab.php:67
msgid "Weekly"
msgstr "Semanal"

#: src/Admin/Tabs/GeneralTab.php:72
msgid "Content types"
msgstr "Tipos de contenido"

#: src/Admin/Tabs/GeneralTab.php:75
msgid "Content types exposed to agents"
msgstr "Tipos de contenido expuestos a los agentes"

#: src/Admin/Tabs/GeneralTab.php:83
msgid "Published items of these types get a Markdown version, appear in llms.txt and are declared in the agent manifest."
msgstr "Los elementos publicados de estos tipos obtienen una versión Markdown, aparecen en llms.txt y se declaran en el manifiesto de agente."

#: src/Admin/Tabs/GeneralTab.php:88
msgid "Regeneration interval"
msgstr "Intervalo de regeneración"

#: src/Admin/Tabs/GeneralTab.php:95
msgid "Markdown documents and discovery files are generated on this schedule, never when a post is saved."
msgstr "Los documentos Markdown y los archivos de descubrimiento se generan con esta programación, nunca al guardar una entrada."

#: src/Admin/Tabs/GeneralTab.php:99
msgid "Items per run"
msgstr "Elementos por ejecución"

#: src/Admin/Tabs/GeneralTab.php:102
msgid "Maximum number of items converted in one scheduled run. Large sites are processed over several runs."
msgstr "Número máximo de elementos convertidos en una ejecución programada. Los sitios grandes se procesan en varias ejecuciones."

#. translators: 1: required PHP version, 2: current PHP version.
#: wp-agent-support-layer.php:57
#, php-format
msgid "WP Agent Support Layer requires PHP %1$s or newer. This site runs PHP %2$s."
msgstr "WP Agent Support Layer requiere PHP %1$s o superior. Este sitio usa PHP %2$s."

#. translators: 1: required WordPress version, 2: current WordPress version.
#: wp-agent-support-layer.php:66
#, php-format
msgid "WP Agent Support Layer requires WordPress %1$s or newer. This site runs WordPress %2$s."
msgstr "WP Agent Support Layer requiere WordPress %1$s o superior. Este sitio usa WordPress %2$s."

#: src/Admin/GenerationStatus.php:87
msgid "You do not have permission to do this."
msgstr "No tienes permiso para hacer esto."

#: src/Admin/GenerationStatus.php:112
msgid "Generation status"
msgstr "Estado de la generación"

#: src/Admin/GenerationStatus.php:114
msgid "A generation run has been scheduled and will start in the background."
msgstr "Se ha programado una ejecución de generación que comenzará en segundo plano."

#: src/Admin/GenerationStatus.php:116
msgid "A full regeneration has been scheduled and will run in the background over one or more batches."
msgstr "Se ha programado una regeneración completa que se ejecutará en segundo plano en uno o varios lotes."

#: src/Admin/GenerationStatus.php:119
msgid "WP-Cron is disabled on this site (DISABLE_WP_CRON). Generation depends on a system cron calling wp-cron.php or on the \"wp wpasl generate\" WP-CLI command."
msgstr "WP-Cron está desactivado en este sitio (DISABLE_WP_CRON). La generación depende de un cron del sistema que llame a wp-cron.php o del comando WP-CLI \"wp wpasl generate\"."

#: src/Admin/GenerationStatus.php:123
msgid "Eligible items"
msgstr "Elementos elegibles"

#: src/Admin/GenerationStatus.php:124
msgid "With a generated document"
msgstr "Con documento generado"

#: src/Admin/GenerationStatus.php:125
msgid "Pending"
msgstr "Pendientes"

#: src/Admin/GenerationStatus.php:126
msgid "Last run"
msgstr "Última ejecución"

#: src/Admin/GenerationStatus.php:127
msgid "Last completed cycle"
msgstr "Último ciclo completado"

#: src/Admin/GenerationStatus.php:128
msgid "Next scheduled run"
msgstr "Próxima ejecución programada"

#: src/Admin/GenerationStatus.php:128
msgid "Not scheduled"
msgstr "No programada"

#: src/Admin/GenerationStatus.php:134
msgid "Regenerate now"
msgstr "Regenerar ahora"

#: src/Admin/GenerationStatus.php:135
msgid "Regenerate everything"
msgstr "Regenerar todo"

#: src/Admin/GenerationStatus.php:136
msgid "Both actions run in the background. \"Regenerate now\" processes the next batch; \"Regenerate everything\" starts a new cycle over all eligible items."
msgstr "Ambas acciones se ejecutan en segundo plano. \"Regenerar ahora\" procesa el siguiente lote; \"Regenerar todo\" inicia un nuevo ciclo sobre todos los elementos elegibles."

#: src/Admin/GenerationStatus.php:149
msgid "Never"
msgstr "Nunca"

#: src/Plugin.php:160
msgid "WP Agent Support Layer: the bundled HTML-to-Markdown library is missing. Install a release build, or run \"composer run build\" in the plugin directory."
msgstr "WP Agent Support Layer: falta la librería HTML a Markdown incluida. Instala una versión de release o ejecuta \"composer run build\" en el directorio del plugin."

#: src/Admin/Tabs/SignalsTab.php:49
msgid "Signals"
msgstr "Señales"

#: src/Admin/Tabs/SignalsTab.php:70
msgid "Search"
msgstr "Búsqueda"

#: src/Admin/Tabs/SignalsTab.php:72
msgid "Building a search index and showing links and short excerpts in results. Does not include AI-generated summaries."
msgstr "Construir un índice de búsqueda y mostrar enlaces y extractos breves en los resultados. No incluye resúmenes generados por IA."

#: src/Admin/Tabs/SignalsTab.php:75
msgid "AI input"
msgstr "Entrada para IA"

#: src/Admin/Tabs/SignalsTab.php:77
msgid "Using the content as input for AI models in real time: answer engines, retrieval-augmented generation, on-demand agents."
msgstr "Usar el contenido como entrada de modelos de IA en tiempo real: motores de respuestas, generación aumentada por recuperación, agentes bajo demanda."

#: src/Admin/Tabs/SignalsTab.php:80
msgid "AI training"
msgstr "Entrenamiento de IA"

#: src/Admin/Tabs/SignalsTab.php:82
msgid "Training or fine-tuning AI models. When set to No, the site also sends \"noai, noimageai\" in X-Robots-Tag and the robots meta tag."
msgstr "Entrenar o ajustar modelos de IA. Con No, el sitio envía además \"noai, noimageai\" en X-Robots-Tag y en la meta etiqueta robots."

#: src/Admin/Tabs/SignalsTab.php:86
msgid "These preferences are published in robots.txt (Content-Signal directive), in the Content-Signal HTTP header of every public response and as robots directives. They are declarations, not enforcement; use the Crawlers tab to decide which AI crawlers may fetch the site."
msgstr "Estas preferencias se publican en robots.txt (directiva Content-Signal), en la cabecera HTTP Content-Signal de cada respuesta pública y como directivas robots. Son declaraciones, no un bloqueo; usa la pestaña Crawlers para decidir qué crawlers de IA pueden acceder al sitio."

#: src/Admin/Tabs/SignalsTab.php:95
msgid "Yes"
msgstr "Sí"

#: src/Admin/Tabs/SignalsTab.php:96
msgid "No"
msgstr "No"

#: src/Admin/Tabs/SignalsTab.php:103
msgid "Content-Usage header"
msgstr "Cabecera Content-Usage"

#: src/Admin/Tabs/SignalsTab.php:107
msgid "Also send the experimental IETF AIPREF \"Content-Usage\" header (train-ai, search)."
msgstr "Enviar también la cabecera experimental \"Content-Usage\" del IETF AIPREF (train-ai, search)."

#: src/Admin/Tabs/SignalsTab.php:109
msgid "The AIPREF specification is still a draft; disable this if its syntax changes."
msgstr "La especificación AIPREF sigue siendo un borrador; desactívalo si su sintaxis cambia."

#: src/Admin/Tabs/CrawlersTab.php:61
msgid "Crawlers"
msgstr "Crawlers"

#: src/Admin/Tabs/CrawlersTab.php:83
msgid "Each AI crawler gets its own group in robots.txt. \"Default\" follows the Content Signals; choose Allow or Block to override a single crawler."
msgstr "Cada crawler de IA tiene su propio grupo en robots.txt. \"Por defecto\" sigue los Content Signals; elige Permitir o Bloquear para sobrescribir un crawler concreto."

#: src/Admin/Tabs/CrawlersTab.php:84
msgid "Microsoft Copilot uses Bingbot and Google Gemini uses Google-Extended; they cannot be separated from regular search indexing beyond what those tokens allow."
msgstr "Microsoft Copilot usa Bingbot y Google Gemini usa Google-Extended; no pueden separarse de la indexación de búsqueda habitual más allá de lo que permiten esos tokens."

#: src/Admin/Tabs/CrawlersTab.php:86
msgid "A physical robots.txt file exists in the site root. WordPress does not serve the generated rules; copy the text below into your file."
msgstr "Existe un archivo robots.txt físico en la raíz del sitio. WordPress no sirve las reglas generadas; copia el texto de abajo en tu archivo."

#: src/Admin/Tabs/CrawlersTab.php:91
msgid "Current default: Block."
msgstr "Valor por defecto actual: Bloquear."

#: src/Admin/Tabs/CrawlersTab.php:91
msgid "Current default: Allow."
msgstr "Valor por defecto actual: Permitir."

#: src/Admin/Tabs/CrawlersTab.php:95
msgid "User-agent"
msgstr "User-agent"

#: src/Admin/Tabs/CrawlersTab.php:96
msgid "Vendor"
msgstr "Proveedor"

#: src/Admin/Tabs/CrawlersTab.php:97
msgid "Policy"
msgstr "Política"

#: src/Admin/Tabs/CrawlersTab.php:98
msgid "Effective"
msgstr "Efectiva"

#: src/Admin/Tabs/CrawlersTab.php:112
msgid "Documentation"
msgstr "Documentación"

#: src/Admin/Tabs/CrawlersTab.php:117
msgid "Default"
msgstr "Por defecto"

#: src/Admin/Tabs/CrawlersTab.php:118
#: src/Admin/Tabs/CrawlersTab.php:121
msgid "Allow"
msgstr "Permitir"

#: src/Admin/Tabs/CrawlersTab.php:119
#: src/Admin/Tabs/CrawlersTab.php:121
msgid "Block"
msgstr "Bloquear"

#: src/Admin/Tabs/CrawlersTab.php:127
msgid "Generated robots.txt"
msgstr "robots.txt generado"

#: src/Admin/Tabs/CrawlersTab.php:128
msgid "Read-only preview of what WordPress serves at /robots.txt with the saved settings."
msgstr "Vista previa de solo lectura de lo que WordPress sirve en /robots.txt con los ajustes guardados."

#: src/Robots/Catalog.php:26
msgid "Training crawlers"
msgstr "Crawlers de entrenamiento"

#: src/Robots/Catalog.php:27
msgid "AI search crawlers"
msgstr "Crawlers de búsqueda con IA"

#: src/Robots/Catalog.php:28
msgid "On-demand agents"
msgstr "Agentes bajo demanda"

#: src/Robots/Catalog.php:39
msgid "Collect content to train or fine-tune models. Follows the \"AI training\" signal by default."
msgstr "Recopilan contenido para entrenar o ajustar modelos. Siguen la señal \"Entrenamiento de IA\" por defecto."

#: src/Robots/Catalog.php:40
msgid "Index content for AI-powered search and answer engines. Follows the \"Search\" signal by default."
msgstr "Indexan contenido para buscadores y motores de respuestas con IA. Siguen la señal \"Búsqueda\" por defecto."

#: src/Robots/Catalog.php:41
msgid "Fetch pages on behalf of a user during a conversation. Follows the \"AI input\" signal by default."
msgstr "Obtienen páginas en nombre de un usuario durante una conversación. Siguen la señal \"Entrada para IA\" por defecto."

#: src/Robots/RobotsTxt.php:156
msgid "A physical robots.txt file exists in the site root, so WordPress does not serve the generated one. Copy the rules from the Crawlers tab into that file."
msgstr "Existe un archivo robots.txt físico en la raíz del sitio, así que WordPress no sirve el generado. Copia las reglas de la pestaña Crawlers en ese archivo."

#. translators: %s: URL of llms.txt.
#: src/Admin/Tabs/LlmsTab.php:75
#, php-format
msgid "Published at %s: the site name, a description, an optional introduction and one section per content type linking to the Markdown version of each item."
msgstr "Publicado en %s: el nombre del sitio, una descripción, una introducción opcional y una sección por tipo de contenido con enlaces a la versión Markdown de cada elemento."

#: src/Admin/Tabs/LlmsTab.php:81
msgid "A physical llms.txt file exists in the site root and takes precedence over the generated one."
msgstr "Existe un archivo llms.txt físico en la raíz del sitio y tiene prioridad sobre el generado."

#: src/Admin/Tabs/LlmsTab.php:85
msgid "Site description"
msgstr "Descripción del sitio"

#: src/Admin/Tabs/LlmsTab.php:88
msgid "One or two sentences shown as the summary block. Defaults to the site tagline."
msgstr "Una o dos frases que se muestran como bloque de resumen. Por defecto, la descripción corta del sitio."

#: src/Admin/Tabs/LlmsTab.php:92
msgid "Introduction (Markdown)"
msgstr "Introducción (Markdown)"

#: src/Admin/Tabs/LlmsTab.php:95
msgid "Optional free text placed before the content sections: what the site is about, key products, how to get in touch."
msgstr "Texto libre opcional antes de las secciones de contenido: de qué trata el sitio, productos clave, cómo contactar."

#: src/Admin/Tabs/LlmsTab.php:99
msgid "Items per section"
msgstr "Elementos por sección"

#: src/Admin/Tabs/LlmsTab.php:102
msgid "Pages are listed by menu order, other types by publication date, newest first."
msgstr "Las páginas se listan por orden de menú; los demás tipos por fecha de publicación, primero los más recientes."

#: src/Admin/Tabs/LlmsTab.php:106
msgid "llms-full.txt"
msgstr "llms-full.txt"

#: src/Admin/Tabs/LlmsTab.php:110
msgid "Also publish /llms-full.txt with the full Markdown of every indexed item concatenated."
msgstr "Publicar también /llms-full.txt con el Markdown completo de todos los elementos indexados concatenados."

#: src/Admin/Tabs/LlmsTab.php:112
msgid "Useful for agents that want the whole site in one request. Disabled by default because the file can get large."
msgstr "Útil para agentes que quieren todo el sitio en una sola petición. Desactivado por defecto porque el archivo puede crecer mucho."

#: src/Admin/Tabs/LlmsTab.php:116
msgid "llms-full.txt size limit (MB)"
msgstr "Límite de tamaño de llms-full.txt (MB)"

#: src/Admin/Tabs/LlmsTab.php:119
msgid "When the limit is reached the file stops at the last complete item and ends with a note saying it was truncated."
msgstr "Al alcanzar el límite, el archivo se detiene en el último elemento completo y termina con una nota indicando que fue truncado."

#. translators: %s: site name.
#: src/Llms/LlmsTxtBuilder.php:153
#, php-format
msgid "Content index of %s."
msgstr "Índice de contenidos de %s."

#. translators: %s: URL of llms.txt.
#: src/Llms/LlmsTxtBuilder.php:205
#, php-format
msgid "Concatenated Markdown of the content indexed in %s."
msgstr "Markdown concatenado del contenido indexado en %s."

#. translators: 1: size limit, 2: URL of llms.txt.
#: src/Llms/LlmsTxtBuilder.php:210
#, php-format
msgid "Truncated: this file reached its %1$s limit. The complete index is in %2$s."
msgstr "Truncado: este archivo alcanzó su límite de %1$s. El índice completo está en %2$s."
