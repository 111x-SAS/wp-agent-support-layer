#. Plugin Name of the plugin
#: wp-agent-support-layer.php
msgid "WP Agent Support Layer"
msgstr "WP Agent Support Layer"

#. Plugin URI of the plugin
#: wp-agent-support-layer.php
msgid "https://github.com/111x-SAS/wp-agent-support-layer"
msgstr "https://github.com/111x-SAS/wp-agent-support-layer"

#. Description of the plugin
#: wp-agent-support-layer.php
msgid "Makes your site discoverable, readable and operable by AI agents and crawlers: Markdown delivery, Content Signals, AI crawler rules in robots.txt, llms.txt and agent manifests."
msgstr "Hace que tu sitio sea descubrible, legible y operable por agentes y crawlers de IA: entrega en Markdown, Content Signals, reglas para crawlers de IA en robots.txt, llms.txt y manifiestos de agente."

#. Author of the plugin
#: wp-agent-support-layer.php
msgid "Mao Rodriguez"
msgstr "Mao Rodriguez"

#. Author URI of the plugin
#: wp-agent-support-layer.php
msgid "https://111x.co"
msgstr "https://111x.co"

#: src/Admin/ExcludeMetaBox.php:69
msgid "Exclude from the agent layer (Markdown, llms.txt, manifests)."
msgstr "Excluir de la capa de agentes (Markdown, llms.txt, manifiestos)."

#: src/Admin/ExcludeMetaBox.php:104
#: src/Admin/Page.php:92
#: src/Admin/Page.php:93
#: src/Admin/Page.php:175
msgid "Agent Support Layer"
msgstr "Agent Support Layer"

#: src/Admin/ExcludeMetaBox.php:123
msgid "Exclude from the agent layer"
msgstr "Excluir de la capa de agentes"

#: src/Admin/ExcludeMetaBox.php:125
msgid "Hides this item from the Markdown version, llms.txt and the agent manifest."
msgstr "Oculta este elemento de la versión Markdown, de llms.txt y del manifiesto de agente."

#: src/Admin/Page.php:126
msgid "Settings"
msgstr "Ajustes"

#: src/Admin/Page.php:167
msgid "You do not have permission to access this page."
msgstr "No tienes permiso para acceder a esta página."

#: src/Admin/Page.php:177
msgid "Secondary menu"
msgstr "Menú secundario"

#: src/Admin/Tabs/GeneralTab.php:45
msgid "General"
msgstr "General"

#: src/Admin/Tabs/GeneralTab.php:64
msgid "Hourly"
msgstr "Cada hora"

#: src/Admin/Tabs/GeneralTab.php:65
msgid "Twice daily"
msgstr "Dos veces al día"

#: src/Admin/Tabs/GeneralTab.php:66
msgid "Daily"
msgstr "Diario"

#: src/Admin/Tabs/GeneralTab.php:67
msgid "Weekly"
msgstr "Semanal"

#: src/Admin/Tabs/GeneralTab.php:72
msgid "Content types"
msgstr "Tipos de contenido"

#: src/Admin/Tabs/GeneralTab.php:75
msgid "Content types exposed to agents"
msgstr "Tipos de contenido expuestos a los agentes"

#: src/Admin/Tabs/GeneralTab.php:83
msgid "Published items of these types get a Markdown version, appear in llms.txt and are declared in the agent manifest."
msgstr "Los elementos publicados de estos tipos obtienen una versión Markdown, aparecen en llms.txt y se declaran en el manifiesto de agente."

#: src/Admin/Tabs/GeneralTab.php:88
msgid "Regeneration interval"
msgstr "Intervalo de regeneración"

#: src/Admin/Tabs/GeneralTab.php:95
msgid "Markdown documents and discovery files are generated on this schedule, never when a post is saved."
msgstr "Los documentos Markdown y los archivos de descubrimiento se generan con esta programación, nunca al guardar una entrada."

#: src/Admin/Tabs/GeneralTab.php:99
msgid "Items per run"
msgstr "Elementos por ejecución"

#: src/Admin/Tabs/GeneralTab.php:102
msgid "Maximum number of items converted in one scheduled run. Large sites are processed over several runs."
msgstr "Número máximo de elementos convertidos en una ejecución programada. Los sitios grandes se procesan en varias ejecuciones."

#. translators: 1: required PHP version, 2: current PHP version.
